{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sam052003/AirGuard-AI/blob/main/docs/schemas/report.schema.json",
  "title": "AirGuard v0.1 Agent Response (planned)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "ok",
        "partial",
        "needs_input",
        "unavailable",
        "out_of_horizon"
      ]
    },
    "interpreted_request": {
      "type": "object"
    },
    "official_aqi": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "station_id": {
          "type": "string"
        },
        "official_aqi": {
          "type": [
            "number",
            "null"
          ]
        },
        "published_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_id": {
          "const": "AQX_P_432"
        }
      },
      "required": [
        "station_id",
        "official_aqi",
        "published_at_utc",
        "source_id"
      ]
    },
    "forecasts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "station_id": {
            "type": "string"
          },
          "horizon_hours": {
            "enum": [
              1,
              3,
              6
            ]
          },
          "pm25_ug_m3": {
            "type": "number",
            "minimum": 0
          },
          "model_version": {
            "type": "string"
          },
          "origin_at": {
            "type": "string",
            "format": "date-time"
          },
          "target_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "station_id",
          "horizon_hours",
          "pm25_ug_m3",
          "model_version",
          "origin_at",
          "target_at"
        ]
      }
    },
    "considered_windows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "recommendation": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at_utc": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "source_id",
          "source_url",
          "retrieved_at_utc"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "status",
    "interpreted_request",
    "official_aqi",
    "forecasts",
    "considered_windows",
    "recommendation",
    "sources",
    "limitations",
    "generated_at"
  ]
}
