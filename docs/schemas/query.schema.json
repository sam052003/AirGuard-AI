{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sam052003/AirGuard-AI/blob/main/docs/schemas/query.schema.json",
  "title": "AirGuard v0.1 Query Request (planned)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query_text": {
      "type": "string",
      "minLength": 1
    },
    "station_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9A-Za-z_-]+$"
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "activity_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "population_group": {
      "enum": [
        "general",
        "sensitive",
        "unspecified"
      ]
    },
    "start_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "end_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "timezone": {
      "const": "Asia/Taipei"
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "query_text",
    "population_group",
    "timezone"
  ]
}
